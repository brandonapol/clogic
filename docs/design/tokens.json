{
  "$description": "clogic design tokens. Format follows the W3C Design Tokens Community Group draft ($value / $type). Dark is the default theme; light mirrors every dark colour key.",
  "color": {
    "dark": {
      "bg": {
        "canvas": { "$type": "color", "$value": "#161618" },
        "surface": { "$type": "color", "$value": "#1F1F22" },
        "raised": { "$type": "color", "$value": "#2A2A2E" },
        "overlay": { "$type": "color", "$value": "#33333A" },
        "scrim": { "$type": "color", "$value": "#0A0A0BB3" },
        "userBubble": { "$type": "color", "$value": "#1E3A52" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "#34343A" },
        "strong": { "$type": "color", "$value": "#73737B" },
        "focus": { "$type": "color", "$value": "#4CC2FF" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#ECECEF" },
        "secondary": { "$type": "color", "$value": "#A6A6AE" },
        "tertiary": { "$type": "color", "$value": "#95959E" },
        "onAccent": { "$type": "color", "$value": "#08131B" },
        "onCaution": { "$type": "color", "$value": "#1A1204" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "#4CC2FF" },
        "hover": { "$type": "color", "$value": "#7AD3FF" },
        "muted": { "$type": "color", "$value": "#4CC2FF26" }
      },
      "status": {
        "success": { "$type": "color", "$value": "#5FD38D" },
        "caution": { "$type": "color", "$value": "#FFB23F" },
        "cautionMuted": { "$type": "color", "$value": "#FFB23F1F" },
        "danger": { "$type": "color", "$value": "#FF6B6B" },
        "dangerMuted": { "$type": "color", "$value": "#FF6B6B1F" }
      },
      "meter": {
        "safe": { "$type": "color", "$value": "#5FD38D" },
        "warn": { "$type": "color", "$value": "#E8D44D" },
        "over": { "$type": "color", "$value": "#FF5A5A" },
        "track": { "$type": "color", "$value": "#0E0E10" },
        "reference": { "$type": "color", "$value": "#A6A6AE" }
      }
    },
    "light": {
      "bg": {
        "canvas": { "$type": "color", "$value": "#F5F5F7" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "raised": { "$type": "color", "$value": "#EDEDF0" },
        "overlay": { "$type": "color", "$value": "#FFFFFF" },
        "scrim": { "$type": "color", "$value": "#00000059" },
        "userBubble": { "$type": "color", "$value": "#DCEBF7" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "#DCDCE0" },
        "strong": { "$type": "color", "$value": "#85858D" },
        "focus": { "$type": "color", "$value": "#0A6FB0" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#1C1C1E" },
        "secondary": { "$type": "color", "$value": "#55555C" },
        "tertiary": { "$type": "color", "$value": "#636369" },
        "onAccent": { "$type": "color", "$value": "#FFFFFF" },
        "onCaution": { "$type": "color", "$value": "#FFFFFF" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "#0A6FB0" },
        "hover": { "$type": "color", "$value": "#085A8F" },
        "muted": { "$type": "color", "$value": "#0A6FB01F" }
      },
      "status": {
        "success": { "$type": "color", "$value": "#1A7040" },
        "caution": { "$type": "color", "$value": "#9A5B00" },
        "cautionMuted": { "$type": "color", "$value": "#9A5B001A" },
        "danger": { "$type": "color", "$value": "#C62828" },
        "dangerMuted": { "$type": "color", "$value": "#C628281A" }
      },
      "meter": {
        "safe": { "$type": "color", "$value": "#1A7040" },
        "warn": { "$type": "color", "$value": "#756200" },
        "over": { "$type": "color", "$value": "#C62828" },
        "track": { "$type": "color", "$value": "#E2E2E6" },
        "reference": { "$type": "color", "$value": "#55555C" }
      }
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "SF Pro Text",
          "Helvetica Neue",
          "Inter",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SF Mono", "Menlo", "JetBrains Mono", "monospace"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "11px" },
      "meta": { "$type": "dimension", "$value": "12px" },
      "body": { "$type": "dimension", "$value": "13px" },
      "title": { "$type": "dimension", "$value": "15px" },
      "display": { "$type": "dimension", "$value": "20px" },
      "readout": { "$type": "dimension", "$value": "22px" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.45 }
    },
    "letterSpacing": {
      "label": { "$type": "dimension", "$value": "0.06em" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "2px" },
    "2": { "$type": "dimension", "$value": "4px" },
    "3": { "$type": "dimension", "$value": "6px" },
    "4": { "$type": "dimension", "$value": "8px" },
    "5": { "$type": "dimension", "$value": "12px" },
    "6": { "$type": "dimension", "$value": "16px" },
    "7": { "$type": "dimension", "$value": "20px" },
    "8": { "$type": "dimension", "$value": "24px" },
    "9": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "3px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "dialog": { "$type": "shadow", "$value": "0 12px 32px #00000080, 0 0 0 1px #FFFFFF14" },
    "popover": { "$type": "shadow", "$value": "0 6px 16px #00000066, 0 0 0 1px #FFFFFF14" }
  },
  "icon": {
    "size": {
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" }
    },
    "stroke": { "$type": "dimension", "$value": "1.5px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "240ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "inOut": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
    },
    "meterRefreshHz": { "$type": "number", "$value": 10 }
  },
  "layout": {
    "window": {
      "defaultWidth": { "$type": "dimension", "$value": "440px" },
      "defaultHeight": { "$type": "dimension", "$value": "680px" },
      "minWidth": { "$type": "dimension", "$value": "360px" },
      "minHeight": { "$type": "dimension", "$value": "480px" }
    },
    "headerHeight": { "$type": "dimension", "$value": "40px" },
    "bubbleMaxWidth": { "$type": "dimension", "$value": "88%" },
    "hitTargetMin": { "$type": "dimension", "$value": "24px" }
  }
}
